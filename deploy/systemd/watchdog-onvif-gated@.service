[Unit]
Description=WatchDog ONVIF gated collector for camera %i
Wants=network-online.target
After=network-online.target hailort.service
PartOf=watchdog-onvif-gated.target

[Service]
Type=simple
User=moai
WorkingDirectory=/home/moai/Workspace/Codex/WatchDog
EnvironmentFile=/home/moai/Workspace/Codex/WatchDog/configs/watchdog-tapo.env
ExecStart=/usr/bin/env bash /home/moai/Workspace/Codex/WatchDog/scripts/run_onvif_gated_service.sh %i
StandardOutput=journal
StandardError=append:/home/moai/Workspace/Codex/WatchDog/watchdog-onvif-%i.stderr.log
Restart=always
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
